<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">

        <!-- POS name / street: antes del bloque de contacto -->
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="before">
            <div style="text-align: center; font-weight: bold; font-size: 110%; margin-bottom: 5px;">
                <t t-esc="props.data.pos_name || ''" />
            </div>
            <div style="text-align: center; margin-bottom: 8px;">
                <t t-esc="props.data.pos_street || ''" />
            </div>
        </xpath>

        <!-- Datos fiscales extra: después del VAT (vatText) -->
        <xpath expr="//div[@t-esc='vatText']" position="after">

            <!-- 🔒 Blindaje: company_extra puede no existir en algunos flujos -->
            <t t-if="props.data.company_extra">
                <!-- CUIT (si querés mostrarlo explícito además del vatText, lo controlamos) -->
                <t t-if="props.data.company_extra.vat">
                    <div>CUIT: <t t-esc="props.data.company_extra.vat || ''"/></div>
                </t>

                <div>Ing. Brutos: <t t-esc="props.data.company_extra.gross_income_number || ''"/></div>
                <div>Inicio de actividades: <t t-esc="props.data.company_extra.afip_start_date || ''"/></div>
                <div><t t-esc="props.data.company_extra.responsibility_name || ''"/></div>

                <t t-if="props.data.company_extra.street">
                    <div>
                        Dirección: <t t-esc="props.data.company_extra.street || ''"/>
                        <t t-if="props.data.company_extra.city">, <t t-esc="props.data.company_extra.city"/></t>
                        <t t-if="props.data.company_extra.state">, <t t-esc="props.data.company_extra.state || ''"/></t>
                        <t t-if="props.data.company_extra.country">, <t t-esc="props.data.company_extra.country || ''"/></t>
                    </div>
                </t>
            </t>

        </xpath>

        <!-- Reemplazar el bloque cashier para meter factura + cliente + cashier -->
        <xpath expr="//div[hasclass('cashier')]" position="replace">
            <t t-if='props.data.invoice_number and props.data.receipt_invoice_number'>
                <div class="afip-invoice-info" style="text-align: center; margin: 8px 0;">
                    <hr style="border-top: 1px solid black;" />
                    <div style="font-size: 120%; font-weight: bold; margin: 5px 0;">
                        <t t-esc="props.data.l10n_latam_document_report_name || ''"/> <t t-esc="props.data.invoice_letter || ''"/> COD. <t t-esc="props.data.l10n_latam_document_type_id_code || ''"/>
                    </div>
                    <div style="margin: 4px 0;">N°: <t t-esc="props.data.invoice_number || ''"/></div>
                    <div style="margin: 4px 0;">FECHA: <t t-esc="props.data.date || ''"/></div>
                    <hr style="border-top: 1px solid black;" />
                </div>
            </t>

            <t t-if="props.data.partner_extra">
                <div style="margin: 8px 0;">
                    <div style="font-weight: bold;">Cliente: <t t-esc="props.data.partner_extra.name || ''"/></div>

                    <t t-if='props.data.invoice_number'>
                        <div style="margin: 3px 0;">
                            <t t-if="props.data.partner_extra.id_type_id and props.data.partner_extra.id_type_id != 7">
                                <t t-esc="props.data.partner_extra.id_type_name || ''" />:
                            </t>
                            <t t-if="props.data.partner_extra.vat">
                                <t t-esc="props.data.partner_extra.vat || ''" />
                            </t>
                        </div>
                        <t t-if="props.data.partner_extra.responsibility_name">
                            <div style="margin: 3px 0;">Responsabilidad: <t t-esc="props.data.partner_extra.responsibility_name || ''" /></div>
                        </t>
                    </t>

                    <t t-if="props.data.partner_extra.street">
                        <div style="margin: 3px 0;">
                            Dirección: <t t-esc="props.data.partner_extra.street || ''"/>
                            <t t-if="props.data.partner_extra.city">, <t t-esc="props.data.partner_extra.city || ''"/></t>
                            <t t-if="props.data.partner_extra.state">, <t t-esc="props.data.partner_extra.state || ''"/></t>
                            <t t-if="props.data.partner_extra.country"> (<t t-esc="props.data.partner_extra.country || ''"/>)</t>
                        </div>
                    </t>

                    <div t-if="props.data.partner_extra.email || props.data.partner_extra.phone" style="margin: 3px 0;">
                        <t t-if="props.data.partner_extra.email">
                            Email: <t t-esc="props.data.partner_extra.email || ''"/>
                        </t>
                        <t t-if="props.data.partner_extra.phone">
                            <t t-if="props.data.partner_extra.email"> | </t>
                            Tel.: <t t-esc="props.data.partner_extra.phone || ''"/>
                        </t>
                    </div>
                </div>
            </t>

            <div t-if="props.data.cashier" class="cashier">
                <hr />
                <div>Cajero: <t t-esc="props.data.cashier || ''" /></div>
            </div>
        </xpath>

    </t>

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- Aquí insertamos el subtotal y los impuestos ANTES del total nativo -->
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="before">
            <!-- Para facturas tipo A (Responsable Inscripto): Mostramos subtotal e impuestos discriminados -->
            <t t-if="props.data.invoice_letter == 'A' and props.data.subtotal">
                <div style="display: flex; justify-content: space-between; margin-top: 15px;">
                    <span>Subtotal:</span>
                    <span t-esc="props.formatCurrency(props.data.subtotal || 0)"/>
                </div>

                <t t-if="props.data.detailed_taxes and props.data.detailed_taxes.length">
                    <t t-foreach="props.data.detailed_taxes" t-as="tax" t-key="tax.id || tax.invoice_label || tax.name">
                        <div style="display: flex; justify-content: space-between; margin-top: 2px;">
                            <span><t t-esc="tax.invoice_label || tax.name || ''"/></span>
                            <span t-esc="props.formatCurrency(tax.amount || 0)"/>
                        </div>
                    </t>
                </t>
            </t>

            <!-- Régimen de Transparencia Fiscal al Consumidor (Ley 27.743) SOLO para facturas Tipo B -->
            <t t-if="props.data.invoice_letter == 'B' and props.data.iva_taxes and props.data.iva_taxes.length">
                <div style="font-weight: bold; margin: 15px 0 5px 0;">Régimen de Transparencia Fiscal al Consumidor (Ley 27.743)</div>

                <t t-foreach="props.data.iva_taxes" t-as="iva_tax" t-key="iva_tax.id || iva_tax.alicuota">
                    <div style="display: flex; justify-content: space-between; margin-top: 3px;">
                        <span>IVA contenido: <t t-esc="iva_tax.alicuota"/>%</span>
                        <span t-esc="props.formatCurrency(iva_tax.amount || 0)"/>
                    </div>
                </t>

                <t t-if="props.data.other_taxes_total > 0">
                    <div style="display: flex; justify-content: space-between; margin-top: 3px;">
                        <span>Otros impuestos nacionales indirectos:</span>
                        <span t-esc="props.formatCurrency(props.data.other_taxes_total || 0)"/>
                    </div>
                </t>
            </t>
        </xpath>

        <xpath expr="//div[@class='before-footer']" position="after">
            <t t-if="props.data.l10n_ar_cae || props.data.l10n_ar_qr_code_base64">
                <div class="afip-cae-info" style="text-align: center; margin-top: 15px; padding-top: 10px; border-top: 1px dashed black;">
                    <t t-if="props.data.terms_and_conditions">
                        <div style="text-align: left; font-size: 85%; margin-bottom: 15px; white-space: pre-line; line-height: 1.3;">
                            <t t-esc="props.data.terms_and_conditions"/>
                        </div>
                    </t>

                    <t t-if="props.data.l10n_ar_qr_code_base64">
                        <div style="margin: 0 auto; width: 160px; height: 160px;">
                            <img t-att-src="'data:image/png;base64,' + props.data.l10n_ar_qr_code_base64" style="width:100%; height:100%;" />
                        </div>
                        <div style="font-size: 180%; font-weight: bold; margin: 10px 0 2px 0; letter-spacing: 2px;">
                            ARCA
                        </div>
                        <div style="font-size: 85%; margin-bottom: 12px;">
                            <strong>Agencia de Recaudación y Control Aduanero</strong>
                        </div>
                    </t>

                    <t t-if="props.data.l10n_ar_cae">
                        <div style="font-size: 90%; margin-top: 5px;">
                            <strong>CAE:</strong> <t t-esc="props.data.l10n_ar_cae || ''"/>
                        </div>
                        <div style="font-size: 90%; margin-top: 3px;">
                            <strong>Vto. CAE:</strong> <t t-esc="props.data.l10n_ar_cae_due_date || ''"/>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@class='pos-receipt-taxes']" position="replace">
            <!-- No hacemos nada aquí, dejamos que Odoo muestre su TOTAL nativo -->
        </xpath>
    </t>

</templates>
